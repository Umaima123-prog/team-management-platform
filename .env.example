# Root-level environment variables for docker-compose (local infra only).
# Copy to .env and adjust if needed. No real secrets belong here or in .env.
# Service-specific variables live in each service's own .env.example.

# --- NATS / JetStream (docker-compose) ---
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
NATS_CLUSTER_PORT=6222
