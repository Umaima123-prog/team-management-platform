# Copy to .env for local development. Never commit the real .env file.
# This service writes ONLY to insights_db - never to management_db,
# and must never query Management Service collections.

ENVIRONMENT=development
LOG_LEVEL=INFO
HEALTH_PORT=8001

# MongoDB Atlas connection string - placeholder only, replace locally
# with your own Atlas cluster's credentials. Required: get_client()
# raises if MONGODB_URI is unset, and get_database() refuses to start
# if MONGODB_DB_NAME is ever anything other than insights_db - there is
# no hardcoded fallback in code. Must point at the insights_db database
# (owned exclusively by this service). GET /readyz reports 503 if this
# database is unreachable.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/insights_db?retryWrites=true&w=majority
MONGODB_DB_NAME=insights_db

# NATS (Core + JetStream share the same client connection)
NATS_URL=nats://localhost:4222
NATS_DURABLE_CONSUMER_NAME=activity-insights-service
