# Copy to .env for local development. Never commit the real .env file.
# This service writes ONLY to management_db - never to insights_db.

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string - placeholder only, replace locally
# with your own Atlas cluster's credentials. Required: the app fails
# fast at startup if MONGODB_URI or MONGODB_DB_NAME is missing - there
# is no hardcoded fallback in code. Must point at the management_db
# database (owned exclusively by this service). GET /health/ready
# reports 503 if this database is unreachable.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/management_db?retryWrites=true&w=majority
MONGODB_DB_NAME=management_db

# NATS (Core + JetStream share the same client connection). Required:
# the app fails fast on first NATS use if this is missing. Connection
# is lazy (see src/messaging/nats/nats-connection.service.ts) - the app
# still boots and serves HTTP traffic if NATS is briefly unreachable.
NATS_URL=nats://localhost:4222

# Outbox publisher relay tuning (all optional - sane defaults in
# src/messaging/relay/outbox-relay.service.ts if unset).
# OUTBOX_RELAY_INTERVAL_MS=1000
# OUTBOX_RELAY_BATCH_SIZE=20
# OUTBOX_RELAY_LEASE_MS=30000

# Core NATS request/reply timeout for GET /api/projects/:id/insights
# and GET /api/projects/:id/activity (optional - defaults to 2000ms if
# unset).
# INSIGHTS_QUERY_TIMEOUT_MS=2000

# Phase 6: comma-separated list of origins the admin UI is served
# from, allowed via CORS (optional - defaults to the Vite dev server's
# default origin, http://localhost:5173, if unset). Never a wildcard -
# see src/main.ts.
# ADMIN_UI_ORIGIN=http://localhost:5173

# Phase 9: real authentication. Required - the app fails fast on
# first login/refresh/token-verification attempt if either secret is
# missing (same "no hardcoded fallback" rule as MONGODB_URI above).
# Generate real random values for any shared/deployed environment,
# e.g. `openssl rand -base64 48` - never reuse these placeholders,
# and never commit the real values anywhere.
JWT_SECRET=<generate-a-long-random-value-never-commit-the-real-one>
JWT_REFRESH_SECRET=<generate-a-different-long-random-value-never-commit-the-real-one>

# Optional - token lifetimes, as jsonwebtoken-style duration strings
# (e.g. "15m", "7d"). Defaults shown.
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=7d

# Phase 9: demo seed passwords (used only by `npm run seed`, never by
# the application itself) - sanitized placeholders appropriate for an
# assignment/demo environment, not real credentials. Override here if
# you want different demo passwords; otherwise `npm run seed` falls
# back to its own built-in demo defaults (see src/seed/seed.ts) and
# prints which account they belong to, never the password itself.
# SEED_ADMIN_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
